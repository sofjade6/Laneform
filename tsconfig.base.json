{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* Les sources sont exécutées telles quelles par tsx / vitest / Node 24
       (type stripping) : aucun artefact de build, donc aucune émission. Les
       imports portent l'extension .ts, ce que Node exige en ESM. */
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
