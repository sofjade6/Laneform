{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laneform-api",
  "main": "src/index.ts",

  // À avancer périodiquement : cette date fige le comportement du runtime.
  "compatibility_date": "2026-10-06",

  // Beaucoup de dépendances touchent aux modules Node ; l'activer évite des
  // erreurs d'import obscures au déploiement.
  "compatibility_flags": ["nodejs_compat"],

  // L'URL *.workers.dev est celle que l'application appelle : on la veut, mais
  // déclarée plutôt que subie.
  "workers_dev": true,

  // Les URL de prévisualisation exposent publiquement chaque version déployée.
  // Inutile ici, et c'est de la surface en plus pour un service qui détient
  // une clé API : seule la version courante a vocation à être joignable.
  "preview_urls": false,

  // Non secret : le plafond annoncé par la clé, ajustable sans redéployer le code.
  "vars": {
    "RIOT_APP_RATE_LIMITS": "500:10,30000:600"
  },

  "observability": {
    "enabled": true,
    // Échantillonnage des traces : suffisant pour diagnostiquer sans saturer
    // les quotas du palier gratuit.
    "head_sampling_rate": 0.1
  }

  // RIOT_API_KEY n'est PAS ici : c'est un secret, posé par
  // `wrangler secret put RIOT_API_KEY`.
}
