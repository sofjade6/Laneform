# Riot API — clé dev (expire toutes les 24h) ou production
# https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Plafonds de la clé. Format: "count:windowSeconds,count:windowSeconds"
# Dev key      -> 20:1,100:120
# Production   -> 500:10,30000:600   (à confirmer sur le portail dev)
RIOT_APP_RATE_LIMITS=20:1,100:120

# Marge de sécurité: on ne consomme que X% du quota annoncé.
# Protège de la dérive entre pods et des 429 qui menacent la clé.
RIOT_RATE_LIMIT_HEADROOM=0.9

DATABASE_URL=postgres://laneform:laneform@localhost:5432/laneform
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

# Backend Laneform (facultatif).
#
# Renseigné, les rangs des joueurs passent par ce service, qui détient la clé
# API — c'est le mode requis pour distribuer l'application, la clé ne pouvant
# pas vivre dans un exécutable remis à des tiers.
#
# Laissé vide, l'application appelle Riot directement avec RIOT_API_KEY, ce
# qui convient à un usage personnel.
#
# La collecte de statistiques exige de toute façon une clé locale : un
# utilisateur sans clé consulte, il ne collecte pas.
# LANEFORM_API_URL=https://laneform-api.votre-compte.workers.dev
