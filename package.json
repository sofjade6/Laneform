{
  "name": "laneform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --pretty && tsc --noEmit --pretty -p apps/desktop/tsconfig.renderer.json && tsc --noEmit --pretty -p apps/api/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "desktop:dev": "npm run -w @laneform/desktop dev",
    "desktop:build": "npm run -w @laneform/desktop build",
    "api:dev": "npm run -w @laneform/api dev",
    "api:deploy": "npm run -w @laneform/api deploy"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
